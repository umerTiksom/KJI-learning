<div class="card w-100 border-0" style="min-height: 129px; border-radius: 8px">

  <div class="card-body d-flex flex-row justify-content-center align-items-center gap-3">

    <div class="rounded-circle d-flex justify-content-center align-items-center flex-shrink-0"
         style="width: 72px; height: 72px; background: #DADCDE;">
      <%= image_tag card["icon"],
                    alt: "",
                    style: "width: 43px; height: 41px; object-fit: contain;" %>
    </div>

    <div class="flex-grow-1" style="min-width: 0">
      <h3 class="card-title mb-2 fw-medium fs-5"><%= card["title"] %></h3>
      <p class="card-text mb-0"
         style="font-weight: 400; font-size: 14px; line-height: 22px; color: #777">
        <%= card["description"] %>
      </p>
    </div>

    <div class="flex-shrink-0">
      <span class="d-flex justify-content-center align-items-center rounded-circle"
            style="width: 42px; height: 42px; background: #1f3a6b;">
        <i class="bi bi-arrow-up-right text-white" aria-hidden="true"></i>
      </span>
    </div>

  </div>

</div>
