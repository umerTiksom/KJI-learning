<div class="col-md-3">
  <div class="card d-flex flex-column align-items-center p-4" style="width: 347px;height: 262px;border-radius: 26px">
    <div class="">
      <div class="d-flex justify-content-center align-items-center" style="width: 62px;height: 62px;background: #F5F2EF;border-radius: 17px">
        <%= image_tag card["logo"] , style:"width:26px;height:26px"%>
      </div>
      <div class=" fw-semibold py-3" style="width: 100%;font-size: 22px;font-weight: 600;line-height: 36px">
        <%= card["title"]%>
      </div>
      <div class="text-secondary paragraph" style="width: 284px;font-size: 18px;line-height: 24px;font-weight: 400">
      <%= card['description'] %>
      </div>
    </div>
  </div>
</div>