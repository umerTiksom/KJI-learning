<style>
    .event-image-wrapper {
        position: relative;
    }

    .event-type-badge {
        position: absolute;
        top: 20px;
        left: 22px;
        width: 110px;
        height: 28px;
        background: #0866d8;
        color: white;

        padding: 6px 15px;

        border-radius: 50px;

        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.8px;

    }
</style>
<div class="col-12 col-md-6 col-lg-4">

  <div class="event-card card border-0" style="width: 470px;min-height:448px ">

    <!-- Event Image -->
    <div class="event-image-wrapper position-relative">

      <%= image_tag card["image"],
                    class: "event-card-image w-100" %>

      <!-- Event Type -->
      <span class="event-type-badge text-center">
        <%= card["type"] %>
      </span>

    </div>


    <!-- Card Content -->
    <div class=" mt-0 bg-white shadow-sm"; style="height: 250px">
    <div class="event-card-body mt-3 ms-3 ">

      <!-- Date + Title -->
      <div class="d-flex flex-column px-2 align-items-start gap-3">

        <!-- Date -->
        <div class="event-date flex-shrink-0 justify-content-center align-items-center text-secondary">

          <span class="event-month fw-medium">
            <%= card["month"] %>
          </span>

          <span class="event-day">
            <%= card["date"] %>,
          </span>

          <span class="event-year fw-medium">
            <%= card["year"] %>
          </span>

        </div>


        <!-- Title + Info -->
        <div class="">

          <h3 class="event-title">
            <%= card["title"] %>
          </h3>

          <div class="event-info d-flex flex-md-column" style="gap: 13px;width: 370px">

            <span>
              <i class="bi bi-geo-alt text-warning"></i>
              <%= card["location"] %>
            </span>

            <span>
              <i class="bi bi-clock text-warning" ></i>
              <%= card["time"] %>
            </span>

          </div>

        </div>

      </div>


      <!-- Divider -->
      <hr class="event-divider ms-3" style="width: 93%">


      <!-- Speaker -->
      <div class="d-flex align-items-center justify-content-between gap-3 ms-2"; style="width: 95%">

        <div class="d-flex align-items-center gap-2">

          <%= image_tag card["speaker_image"],
                        class: "speaker-image" %>

          <div class="mt-3">
            <h4 class="speaker-name"; style="font-size: 18px;font-weight: 500">
              <%= card["speaker_name"] %>
            </h4>

            <p class="speaker-role text-secondary"; style="font-size: 16px;min-height: 11px;font-weight: 500">
              <%= card["speaker_role"] %>
            </p>
          </div>

        </div>


        <!-- Button -->
        <%= button_tag class: "event-details-btn flex-shrink-0 me-2 border-1 rounded-5 text-white", style:"width:126px;height:44px;font-size:14px;font-weight:500; background:#071A33" do %>
          View Details
          <i class="bi bi-arrow-right" style=" "></i>
        <% end %>

      </div>

    </div>
    </div>
  </div>

</div>