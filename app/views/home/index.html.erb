<div class="container-fluid hero-section position-relative w-100">
  <%# hero section %>
  <div class="container context-container ms-lg-5 h-auto">
    <%= render "shared/hero_section_navbar" %>
    <div class="d-flex">
    <div class="text-section flex-grow-1 mt-4">
      <h1 class="">Empowering <br>
        Leaders Throught <br>
        Knowledge,<br>
        <span class="text-warning">Connection & Innovation</span> </h1>
      <p class="mt-3" style="font-weight: 400; font-size: 23px; line-height: 25px">
        Join a global community of professionals, thought leaders and <br>change-makers. Discover meaningful events, expert insights and <br>opportunities to grow together.
      </p>
      <div class="d-flex flex-md-row gap-3 mt-2" >
        <%= button_tag class: "border-0 rounded-5 bg-warning p-1 fw-medium px-3" do%>
          Join Community
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        <% end %>
        <%= button_tag "Explore Events", class:"border-1 rounded-5 px-3"%>
      </div>
      <div class="d-flex align-items-center mt-4">
        <%= image_tag "group_pics.png"%>
        <p class="mt-3 ms-3"> <strong>500+</strong> professionals already part of KJI</p>
      </div>
    </div>
    <div class="image-section d-flex " >
      <%= image_tag "hero_section_image.png",style: "max-width: 800px" %>
    </div>
    </div>
    <div class="text-center mt-5">
      <%= image_tag"icon-bar.png", class:"mb-4"%>
    </div>
  </div>
</div>
<%# event section %>
<div class="bg-white h-auto ">
  <div class="row w-100">
    <div class= "col-md-6 ">
      <%= image_tag "export.png",style: "width:597px; margin-top:100px",class: "ms-lg-5"%>
    </div>
    <div class="col-md-6  d-flex justify-content-end align-items-end ">
      <div class="d-flex  gap-3 me-4">
        <%= button_tag class:"border-1 rounded-5 bg-white px-3" do %>
          View All Events
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        <% end %>
        <%= image_tag "filter-horizontal.png", style: "max-width: 30px; max-height:30px" %>
      </div>
    </div>
  </div>
</div>

<%# about section %>
<div class="container-fluid h-auto mt-5" style="background: #F5F2EF">
  <div class="row w-100">
    <%# text column %>
    <div class="col-md-4">
      <div class="d-flex gap-lg-3 justify-content-start align-items-center">
      <hr class="border-4 rounded-5 mb-4 " style="width: 54px;">
      <h4 style="font-weight: 400;font-size: 20px" >ABOUT KJI COMMUNITY</h4>
    </div>
      <h1 style="font-weight: 700;font-size: 56px;line-height: 55px;letter-spacing: -1.45px">A Community Built <br>
        Around Knowledge,<br>
       <span class="text-warning">Leadership & Impact</span> </h1>
      <p class="mt-4" style="font-weight: 400;font-size: 17px;line-height: 20px">The Knowles Johnson Institute (KJI) is a global <br> learning community bringing together professionals <br>, thought leaders and change-makers to share ideas, build connections and create a more inclusive, innovative future.</p>
      <%= button_tag class:"border-0 rounded-5 px-3 bg-warning py-1" do %>
        Our Story
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
      <% end %>
    </div>
    <%# image column %>
  </div>
</div>