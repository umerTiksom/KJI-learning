<style>
    @font-face {
        font-family: "Main_font1";
        src: url("/assets/HelveticaNowDisplay-Black.woff2") format("woff2");
        font-weight: 900;
        font-style: normal;
    }

    @font-face {
        font-family: "Main_font1_paragraph";
        src: url("/assets/Inter-VariableFont_opsz,wght.ttf") format("truetype");
        font-weight: 100 900;
        font-style: normal;
</style>
<div class="container-fluid hero-section position-relative w-100">
  <%# hero section %>
  <div class="container context-container ms-lg-5 h-auto">
    <div class="d-flex">
    <div class="text-section flex-grow-1 mt-4 ". style="margin-left: 30px">
      <h1 style="font-family:"Main_font1" ">Empowering <br>
        Leaders Throught <br>
        Knowledge,<br>
        <span class="text-warning">Connection & Innovation</span> </h1>
      <p class="mt-3" style="font-weight: 400; font-size: 23px; line-height: 25px;font-family: "Main_font1_paragraph"">
        Join a global community of professionals, thought leaders and <br>change-makers. Discover meaningful events, expert insights and <br>opportunities to grow together.
      </p>
      <div class="d-flex flex-md-row gap-3 mt-2" >
        <%= button_tag class: "border-0 rounded-5 bg-warning p-1 fw-medium px-3" do%>
          Join Community
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        <% end %>
        <%= button_tag "Explore Events", class:"border-1 rounded-5 px-3"%>
      </div>
      <div class="d-flex align-items-center mt-4">
        <%= image_tag "group_pics.png"%>
        <p class="mt-3 ms-3"> <strong>500+</strong> professionals already part of KJI</p>
      </div>
    </div>
    <div class="image-section d-flex " >
      <%= image_tag "hero_section_image.png",style: "max-width: 800px" %>
    </div>
    </div>
    <div class="text-center mt-4 d-flex justify-content-center me-5">

      <!-- Members -->
      <div class="d-flex align-items-center gap-3 border-end pe-4 "
           style="width: 302px; height: 67px">
        <div class="bg-secondary-subtle rounded-5 text-center py-3"
             style="width: 67px; height: 67px">
          <%= image_tag "people_home.png", style: "width:47px;height:37px" %>
        </div>
        <div class="text-start">
          <h1 class="mb-0", style="font-size: 30px;font-weight: 600">500+</h1>
          <p class="mb-0", style="font-size: 18px;font-weight: 500;height: 20px">Members</p>
        </div>
      </div>

      <!-- Events -->
      <div class="d-flex align-items-center gap-3 border-end pe-4 px-4"
           style="width: 302px; height: 67px">
        <div class="bg-secondary-subtle rounded-5 py-3"
             style="width: 67px; height: 67px">
          <%= image_tag "calender_home.png", style: "width:37px;height:37px" %>
        </div>
        <div class="text-start">
          <h1 class="mb-0", style="font-size:30px;font-weight: 600 ">100+</h1>
          <p class="mb-0", style="font-size: 18px;font-weight: 500;height: 20px">Events</p>
        </div>
      </div>

      <!-- Expert Speakers -->
      <div class="d-flex align-items-center gap-3 border-end pe-4 px-4"
           style="width: 302px; height: 67px">
        <div class="bg-secondary-subtle rounded-5 py-3"
             style="width: 67px; height: 67px">
          <%= image_tag "mike_home.png", style: "width:28px;height:37px" %>
        </div>
        <div class="text-start">
          <h1 class="mb-0", style="font-size: 30.6px;font-weight: 600">50+</h1>
          <p class="mb-0", style="font-size: 18px;font-weight: 500;height: 20px">Expert Speakers</p>
        </div>
      </div>

      <!-- Global Community -->
      <div class="d-flex align-items-center gap-3 px-4"
           style="width: 302px; height: 67px">
        <div class="bg-secondary-subtle rounded-5 py-3"
             style="width: 67px; height: 67px">
          <%= image_tag "global_home.png", style: "width:41px;height:42px" %>
        </div>
        <div class="text-start">
          <h1 class="mb-0", style="font-size: 30px;font-weight: 600">Global</h1>
          <p class="mb-0", style="18px;font-weight: 500;height: 20px">Community</p>
        </div>
      </div>

    </div>
  </div>
</div>
<%# event section %>
<style>
    .event-card-image {
        width: 100%;
        height: 207px;
        object-fit: cover;
        display: block;
    }

    @media (max-width: 1199px) {
        .events-container {
            width: calc(100% - 50px);
        }
    }

    @media (max-width: 767px) {
        .events-container {
            width: calc(100% - 30px);
        }
    }
</style>


<div class="bg-white w-100 py-5">

  <div class="events-container" style="width: 1484px;height: auto;margin-left: 60px">

    <!-- Events Header -->
    <div class="row align-items-end mb-5">

      <!-- Left Side -->
      <div class="col-lg-7">

        <div class="d-flex align-items-center gap-3 mb-3">

          <hr
            class="border-4 rounded-5 border-warning opacity-100 m-0"
            style="width: 45px;"
          >

          <span
            class="text-uppercase"
            style="font-size: 18px; letter-spacing: 1px;"
          >
            Events
          </span>

        </div>

        <h1
          class="fw-bold mb-3"
          style="font-size: 44px; line-height: 1.1;"
        >
          Upcoming Events
        </h1>

        <p
          class="text-secondary mb-0"
          style="font-size: 17px; line-height: 20px;"
        >
          Be part of impactful conversations, immersive<br>
          experiences and meaningful connections. Explore our<br>
          upcoming events and find the ones that inspire you.
        </p>

      </div>


      <!-- Right Side -->
      <div class="col-lg-5 d-flex justify-content-lg-end align-items-end mt-4 mt-lg-0">

        <div class="d-flex align-items-center gap-3">

          <%= button_tag class: "border border-dark rounded-5 bg-white px-3 py-2" do %>

            View All Events

            <i class="bi bi-arrow-right ms-1"
               aria-hidden="true"></i>

          <% end %>

          <%= image_tag "filter-horizontal.png",
                        style: "width: 30px; height: 30px;" %>

        </div>

      </div>

    </div>


    <!-- Event Cards -->
    <div class="row g-4" style="width: 1550px;height: auto">

      <% @event_card.each do |card| %>

        <%= render "shared/event_card", card: card %>

      <% end %>

    </div>

  </div>

</div>

<%# about section %>

<section class="w-100 d-flex align-items-center py-5" style="background: #F5F2EF; min-height: 800px">
  <div class="site-container", style="margin-left: 80px">
    <div class="row align-items-center g-5 g-lg-4">

      <div class="col-12 col-lg-4 d-flex flex-column justify-content-center">

        <div class="d-flex align-items-center gap-3 mb-4">
          <span style="display:inline-block; width:50px; height:3px; border-radius:3px; background:#f5c644"></span>
          <h4 class="m-0" style="font-weight:400; font-size:18px; letter-spacing:0.5px">ABOUT KJI COMMUNITY</h4>
        </div>

        <h1 style="font-weight:700; font-size:clamp(36px, 4vw, 56px); line-height:1; letter-spacing:-1.45px">
          A Community Built <br>
          Around Knowledge,<br>
          <span style="color:#f5c644">Leadership &amp; Impact</span>
        </h1>

        <p class="mt-4 mb-4"
           style="max-width:440px; font-weight:400; font-size:17px; line-height:20px; color:#555;
             display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden">
          The Knowles Johnson Institute (KJI) is a global learning community bringing together professionals, thought leaders and change-makers to share ideas, build connections and create a more inclusive, innovative future.
        </p>

        <div>
          <%= button_tag class: "border-0 rounded-5 px-3 py-1 fw-medium",
                         style: "width:148px; height:40px; background:#f5c644" do %>
            Our Story
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
          <% end %>
        </div>

      </div>

      <div class="col-12 col-lg-4 d-flex justify-content-center align-items-center">
        <%= image_tag "about_section_image.png",
                      alt: "KJI community members talking at an event",
                      class: "img-fluid",
                      style: "max-height:640px; width:auto" %>
      </div>

      <div class="col-12 col-lg-4 d-flex">
        <div class="d-flex flex-column gap-2 w-100 ms-lg-auto" style="max-width:392px">
          <% @about_card.each do |card| %>
            <%= render "shared/about_card", card: card %>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</section>
<div>  <%= render "shared/footer" %></div>

